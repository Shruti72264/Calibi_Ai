# ============================================================================
# SENTINEL SOC backend configuration — copy to .env and edit, then run
#   set -a; source .env; set +a; ./run-backend.sh
# Every value has a safe default; the service starts even with nothing set.
# ============================================================================

# --- identity ---------------------------------------------------------------
SOC_ENV=development

# --- live Suricata telemetry ------------------------------------------------
# Point this at the sensor's real EVE log. On a Kali sensor running Suricata
# 8.x with the default config this is /var/log/suricata/eve.json.
SOC_LIVE_ENABLED=true
SOC_LIVE_EVE_PATH=/var/log/suricata/eve.json
# Only the tail of the file is read, so a multi-gigabyte log is fine.
SOC_LIVE_MAX_TAIL_BYTES=8000000
SOC_LIVE_MAX_RECORDS=2000

# --- historical evidence (kept strictly separate from live) -----------------
SOC_HISTORICAL_ENABLED=true
SOC_HISTORICAL_EVE_PATHS=/home/user/soc-backend/data/historical/eve-alerts-history.json
SOC_HISTORICAL_MAX_RECORDS=5000

# --- HTTP -------------------------------------------------------------------
# Add your dashboard's origin(s). The Vite dev server is 5173 by default.
SOC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Ephemeral preview/LAN hosts are matched with this regex instead of "*".
SOC_CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\.e2b\.app$

# --- write protection (FAIL-CLOSED) ----------------------------------------
# Mutating endpoints (analyst notes, response actions, cache reload) stay
# disabled unless BOTH of these are set. Leave SOC_ALLOW_WRITES unset for demos.
#SOC_API_KEY=change-me-to-a-long-random-value
SOC_ALLOW_WRITES=false

# --- controlled response ----------------------------------------------------
# recommend = record a recommendation only (secure default)
# dry_run   = validate + render the exact command, execute nothing
# enforce   = execute on THIS host only, allow-listed targets only
SOC_RESPONSE_MODE=recommend
# Comma/colon separated IPs or CIDRs that enforcement is permitted to touch.
# Empty means enforcement is structurally impossible.
SOC_RESPONSE_ALLOWLIST=
SOC_RESPONSE_MAX_ACTIONS_PER_HOUR=10
SOC_AUDIT_DB=data/audit/soc-audit.sqlite3

# --- Cisco / Packet Tracer --------------------------------------------------
SOC_CISCO_EVIDENCE_PATH=data/cisco/network_evidence.json
# Packet Tracer devices generally expose no SSH/SNMP: leave this OFF unless you
# have verified that your exact devices accept read-only management connections.
SOC_CISCO_LIVE_ENABLED=false
#SOC_CISCO_LIVE_HOSTS=192.168.10.254:22,10.10.10.1:22

# --- host probes ------------------------------------------------------------
SOC_SURICATA_BINARY=suricata
SOC_SURICATA_FAST_LOG=/var/log/suricata/fast.log
SOC_SURICATA_STATS_LOG=/var/log/suricata/stats.log
SOC_SYSTEMCTL_PROBE=true

# --- frontend (used by Vite, not by the API) --------------------------------
VITE_PROXY_TARGET=http://127.0.0.1:8000
